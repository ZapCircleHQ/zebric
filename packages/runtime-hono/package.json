{
  "name": "@zebric/runtime-hono",
  "version": "0.3.1",
  "description": "Shared Hono adapter for Zebric runtimes",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZapCircleHQ/zebric.git",
    "directory": "packages/runtime-hono"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
