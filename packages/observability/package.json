{
  "name": "@zebric/observability",
  "version": "0.3.0",
  "description": "Cross-runtime operational logging and correlation utilities for Zebric",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZapCircleHQ/zebric.git",
    "directory": "packages/observability"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --coverage=false",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "dependencies": {
    "hono": "^4.12.14"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
