{
  "name": "@zebric/agent",
  "version": "0.9.0",
  "description": "First-party agent for operating and authoring Zebric applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "zebric-agent": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZapCircleHQ/zebric.git",
    "directory": "packages/agent"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "pretest": "pnpm --filter @zebric/runtime-node... build",
    "test": "vitest run",
    "pretest:e2e": "pnpm --filter @zebric/runtime-node... build",
    "test:e2e": "vitest run tests/e2e/*.e2e.test.ts",
    "test:package": "pnpm --filter @zebric/agent... build && node scripts/verify-package.mjs",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.18",
    "@langchain/langgraph": "^1.5.1",
    "@zebric/runtime-core": "workspace:*",
    "@zebric/runtime-node": "workspace:*",
    "deepagents": "^1.15.1",
    "langchain": "^1.5.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
