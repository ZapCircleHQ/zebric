{
  "name": "@zebric/runtime-worker",
  "version": "0.8.0",
  "description": "Zebric Runtime - Cloudflare Workers Adapter",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZapCircleHQ/zebric.git",
    "directory": "packages/runtime-worker"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/cloudflare-entrypoint.d.ts",
      "default": "./dist/workflows/cloudflare-entrypoint.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "pnpm --filter @zebric/agent... build",
    "pretest:smoke": "pnpm --filter @zebric/agent... build",
    "pretest:coverage": "pnpm --filter @zebric/agent... build",
    "build": "tsc",
    "test": "vitest run",
    "test:smoke": "vitest run tests/integration/",
    "test:coverage": "vitest run --coverage",
    "dev": "tsc --watch",
    "pretest:conformance": "pnpm --filter @zebric/agent... build",
    "test:conformance": "vitest run tests/integration/conformance.test.ts"
  },
  "keywords": [
    "zebric",
    "runtime",
    "cloudflare",
    "workers",
    "edge"
  ],
  "author": "Zebric Team",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@zebric/runtime-core": "workspace:*",
    "@zebric/runtime-hono": "workspace:*",
    "better-auth": "^1.6.6",
    "cookie": "^1.0.2",
    "hono": "^4.12.14",
    "ulid": "^3.0.2",
    "@zebric/notifications": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260421.1",
    "@types/better-sqlite3": "^7.6.9",
    "@vitest/coverage-v8": "^4.1.5",
    "better-sqlite3": "^12.9.0",
    "miniflare": "^4.20260421.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.84.1"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
