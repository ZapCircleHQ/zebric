{
  "name": "workers-blog-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/predeploy.mjs && wrangler deploy",
    "db:create": "wrangler d1 create zebric-blog-db",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "node scripts/predeploy.mjs && wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@zebric/runtime-worker": "0.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "typescript": "6.0.3",
    "wrangler": "4.116.0"
  }
}
