<style>
.io{--ink:#14213d;--muted:#5f6b7a;--line:#dde3ea;--blue:#1d3557;--orange:#e76f51;max-width:1280px;margin:auto;padding:4px 28px 48px;color:var(--ink);font:14px/1.5 Inter,system-ui,sans-serif}.io *{box-sizing:border-box}.io a{color:inherit}.io h1{font-size:34px;letter-spacing:-.04em;margin:8px 0 4px}.io h2{font-size:15px;margin:0 0 12px}.io h3{font-size:12px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin:16px 0 8px}.io-sub{color:var(--muted);margin:0 0 22px}.io-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:16px}.io-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:16px;align-items:start}.io-row{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #eef1f5}.io-row:last-child{border:0}.io-t{font-weight:700;text-decoration:none}.io-m{color:var(--muted);font-size:12px;margin-top:2px}.io-pill{display:inline-block;border-radius:99px;background:#eef2f7;padding:2px 9px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}.io-pill.blocked,.io-pill.at_risk,.io-pill.high,.io-pill.off_target,.io-pill.degraded{background:#ffe8e0;color:#a2391a}.io-pill.attention,.io-pill.medium,.io-pill.watch,.io-pill.pending{background:#fff3d6;color:#8a5a00}.io-pill.healthy,.io-pill.ready,.io-pill.on_target,.io-pill.decided,.io-pill.completed,.io-pill.done{background:#dff3e6;color:#1d6b3a}.io-empty{color:var(--muted);padding:8px 0}.io-stages{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}.io-stage{background:#f6f8fb;border-radius:12px;padding:12px}.io-stage h3{margin-top:0}.io-init{background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px;margin-bottom:8px}.io-cmd{border-top:1px dashed var(--line);margin-top:12px;padding-top:12px}.io-cmd label{display:block;font-size:11px;color:var(--muted);margin:6px 0 2px}.io-cmd input,.io-cmd textarea,.io-cmd select{width:100%;padding:7px 9px;border:1px solid var(--line);border-radius:8px;font:inherit}.io-cmd textarea{min-height:56px}.io-btn{margin-top:8px;background:var(--blue);color:#fff;border:0;border-radius:8px;padding:8px 14px;font-weight:700;cursor:pointer}.io-btn.alt{background:#fff;color:var(--blue);border:1px solid var(--blue)}.io-nav{display:flex;gap:14px;flex-wrap:wrap;margin:6px 0 20px;font-weight:700}.io-nav a{text-decoration:none;color:var(--muted)}.io-nav a:hover{color:var(--ink)}.io-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:18px}.io-kpi{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px}.io-kpi b{display:block;font-size:26px}.io-kpi span{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}@media(max-width:700px){.io{padding:4px 14px}}
</style>
<script>
document.addEventListener('submit',function(e){var f=e.target;if(!f.classList||!f.classList.contains('cmd'))return;var p={};f.querySelectorAll('[data-p]').forEach(function(x){p[x.getAttribute('data-p')]=x.value});f.elements.payload.value=JSON.stringify(p)});
</script>
<div class="io"><nav class="io-nav"><a href="/">Portfolio</a><a href="/attention">Attention</a><a href="/decisions">Decisions</a><a href="/milestones">Milestones</a><a href="/launches">Launches</a><a href="/operations">Operations</a><a href="/observations">Observations</a><a href="/ideas/new">+ Submit an idea</a></nav>{% assign i = data.initiative[0] %}{% assign nowTs = 'now' | date: '%s' | plus: 0 %}
{% if i %}
<a href="/" style="color:var(--muted);text-decoration:none">← Portfolio</a>
<h1>{{ i.title }}</h1>
<p><span class="io-pill">{{ i.stage }}</span> <span class="io-pill {{ i.health }}">{{ i.health }}</span>
{% if i.healthReason %}<span class="io-m"> {{ i.healthReason }}</span>{% endif %}</p>
<p class="io-sub">{{ i.summary }}</p>
<div class="io-grid">
<div>
<section class="io-card"><h2>Why and what outcome</h2>
{% if i.problemStatement %}<h3>Problem</h3>{{ i.problemStatement }}{% endif %}
{% if i.expectedOutcome %}<h3>Expected outcome</h3>{{ i.expectedOutcome }}{% endif %}
{% if i.successCriteria %}<h3>Success criteria</h3>{{ i.successCriteria }}{% endif %}
{% if i.recommendedApproach %}<h3>Recommended approach</h3>{{ i.recommendedApproach }}{% endif %}
<h3>People</h3><div class="io-m">Owner: {{ i.ownerName | default: "unassigned" }} · Sponsor: {{ i.sponsorName | default: "none" }} · Operational owner: {{ i.operationalOwnerName | default: "none" }}</div>
{% if i.targetLaunchDate %}<div class="io-m">Target launch {{ i.targetLaunchDate | formatDate: "short" }}</div>{% endif %}
{% if i.sourceObservationId %}<div class="io-m">Provenance: created from observation {{ i.sourceObservationId }}</div>{% endif %}
</section>

<section class="io-card"><h2>Evidence ({{ data.evidence.size }})</h2>
{% for e in data.evidence %}<div class="io-row"><div><span class="io-t">{{ e.title }}</span><div class="io-m">{{ e.summary }}{% if e.sourceUrl %} · <a href="{{ e.sourceUrl }}">source</a>{% endif %}</div></div><span class="io-pill">{{ e.type }}</span></div>{% else %}<div class="io-empty">No evidence yet.</div>{% endfor %}</section>

<section class="io-card"><h2>Open questions and assumptions</h2>
{% for q in data.questions %}<div class="io-row"><div><span class="io-t">{{ q.question }}</span>{% if q.answer %}<div class="io-m">{{ q.answer }}</div>{% endif %}</div><span class="io-pill {% if q.status == 'open' %}pending{% endif %}">{{ q.status }}{% if q.blocksProgression and q.status == 'open' %} · blocks{% endif %}</span></div>{% endfor %}
{% for a in data.assumptions %}<div class="io-row"><div><span class="io-t">Assumption: {{ a.statement }}</span>{% if a.resolution %}<div class="io-m">{{ a.resolution }}</div>{% endif %}</div><span class="io-pill {% if a.status == 'open' %}pending{% endif %}">{{ a.status }}{% if a.blocksProgression and a.status == 'open' %} · blocks{% endif %}</span></div>{% endfor %}
{% if data.questions.size == 0 and data.assumptions.size == 0 %}<div class="io-empty">None recorded.</div>{% endif %}</section>

<section class="io-card"><h2>Alternatives</h2>
{% for a in data.alternatives %}<div class="io-row"><div><span class="io-t">{{ a.title }}</span><div class="io-m">{{ a.description }} {% if a.estimatedEffort %}· Effort {{ a.estimatedEffort }}{% endif %}</div></div><span class="io-pill">{{ a.status }}</span></div>{% else %}<div class="io-empty">No alternatives yet.</div>{% endfor %}</section>

<section class="io-card"><h2>Decisions</h2>
{% for d in data.decisions %}<div class="io-row"><div><span class="io-t">{{ d.question }}</span><div class="io-m">{% if d.status == 'decided' %}{{ d.decidedByName }}: {{ d.decision }} — {{ d.rationale }}{% else %}Awaiting decision{% if d.dueDate %} · due {{ d.dueDate | formatDate: "short" }}{% endif %}{% endif %}</div></div><span class="io-pill {{ d.status }}">{{ d.status }} · {{ d.outcome }}</span></div>{% else %}<div class="io-empty">No decisions yet.</div>{% endfor %}</section>
</div>

<div>
<section class="io-card"><h2>Milestones and dependencies</h2>
{% for m in data.milestones %}<div class="io-row"><div><span class="io-t">{{ m.title }}</span>{% if m.isDraft %} <span class="io-pill">draft</span>{% endif %}<div class="io-m">{{ m.ownerName }}{% if m.targetDate %} · {{ m.targetDate | formatDate: "short" }}{% endif %}</div></div><span class="io-pill {{ m.status }}">{{ m.status }}</span></div>{% else %}<div class="io-empty">No milestones.</div>{% endfor %}
<h3>Depends on</h3>{% for d in data.blockedBy %}<div class="io-row"><div><span class="io-t">{{ d.targetLabel }}</span><div class="io-m">{{ d.type }} · {{ d.description }}</div></div><span class="io-pill {% if d.status == 'open' %}blocked{% else %}ready{% endif %}">{{ d.status }}</span></div>{% else %}<div class="io-empty">Nothing.</div>{% endfor %}
<h3>Blocking others</h3>{% for d in data.blocking %}<div class="io-row"><div><span class="io-t">{{ d.sourceLabel }}</span></div><span class="io-pill">{{ d.status }}</span></div>{% else %}<div class="io-empty">Nothing.</div>{% endfor %}
<h3>Tasks ({{ data.tasks.size }})</h3>{% for t in data.tasks %}<div class="io-row"><div><span class="io-t">{{ t.title }}</span><div class="io-m">{{ t.assignedToName }}</div></div><span class="io-pill {{ t.status }}">{{ t.status }}</span></div>{% endfor %}</section>

<section class="io-card"><h2>Risks</h2>{% for r in data.risks %}<div class="io-row"><div><span class="io-t">{{ r.title }}</span><div class="io-m">likelihood {{ r.likelihood }} · impact {{ r.impact }} · {{ r.mitigation }}</div></div><span class="io-pill {% if r.impact == 'high' and r.status == 'open' %}high{% endif %}">{{ r.status }}</span></div>{% else %}<div class="io-empty">No risks recorded.</div>{% endfor %}</section>

<section class="io-card"><h2>Launch readiness</h2>{% for c in data.readiness %}<div class="io-row"><div><span class="io-t">{{ c.title }}</span><div class="io-m">{{ c.category }} · {{ c.ownerName }} {{ c.notes }}</div></div><span class="io-pill {{ c.status }}">{{ c.status }}</span></div>{% else %}<div class="io-empty">No readiness checks yet.</div>{% endfor %}</section>

{% assign cap = data.capability[0] %}{% if cap %}<section class="io-card"><h2>Operations</h2><div class="io-row"><div><span class="io-t">{{ cap.name }}</span><div class="io-m">Owner {{ cap.ownerName }} · review {{ cap.reviewCadence }}{% if cap.runbookUrl %} · <a href="{{ cap.runbookUrl }}">runbook</a>{% endif %}</div></div><span class="io-pill {{ cap.status }}">{{ cap.status }}</span></div>
{% for m in data.metrics %}{% if m.capabilityId == cap.id %}<div class="io-row"><div><span class="io-t">{{ m.name }}</span><div class="io-m">target {{ m.target }} · current {{ m.currentValue }}</div></div><span class="io-pill {{ m.status }}">{{ m.status }}</span></div>{% endif %}{% endfor %}
{% for o in data.observations %}{% if o.capabilityId == cap.id %}<div class="io-row"><div><span class="io-t">{{ o.title }}</span><div class="io-m">{{ o.description }}</div></div><span class="io-pill {{ o.severity }}">{{ o.status }}</span></div>{% endif %}{% endfor %}</section>{% endif %}

<section class="io-card"><h2>How did we get here?</h2>{% for a in data.activity %}<div class="io-row"><div><span class="io-t">{{ a.summary }}</span><div class="io-m">{{ a.actorName }} · {{ a.occurredAt | formatDate: "datetime" }}</div></div><span class="io-pill">{{ a.type }}</span></div>{% else %}<div class="io-empty">No activity.</div>{% endfor %}</section>
</div>
</div>

<section class="io-card"><h2>Commands</h2><div class="io-m">Each command validates stage, role and prerequisites server-side. A refusal means a prerequisite is missing.</div>
{% if i.stage == 'idea' %}<form class="io-cmd cmd" method="POST" action="/actions/StartDiscovery"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Initiative"><input type="hidden" name="recordId" value="{{ i.id }}"><input type="hidden" name="page" value="/initiatives/:id"><input type="hidden" name="redirect" value="/initiatives/{{ i.id }}"><input type="hidden" name="payload" value=""><strong>Start discovery</strong><label>Owner id (user id)</label><input type="text" data-p="ownerId" value="{{ user.id }}"><label>Owner name</label><input type="text" data-p="ownerName" value="{{ user.name }}"><label>Problem statement</label><textarea data-p="problemStatement"></textarea><button class="io-btn" type="submit">Start discovery</button></form>{% endif %}
{% if i.stage == 'discovery' %}<div class="io-m">Submit proposal needs owner, sponsor, expected outcome, success criteria and recommended approach on the record.</div><form class="io-cmd cmd" method="POST" action="/actions/SubmitProposal"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Initiative"><input type="hidden" name="recordId" value="{{ i.id }}"><input type="hidden" name="page" value="/initiatives/:id"><input type="hidden" name="redirect" value="/initiatives/{{ i.id }}"><input type="hidden" name="payload" value=""><strong>Submit proposal</strong><button class="io-btn" type="submit">Submit proposal</button></form>{% endif %}
{% if i.stage == 'proposal' %}<form class="io-cmd cmd" method="POST" action="/actions/ApproveInitiative"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Initiative"><input type="hidden" name="recordId" value="{{ i.id }}"><input type="hidden" name="page" value="/initiatives/:id"><input type="hidden" name="redirect" value="/initiatives/{{ i.id }}"><input type="hidden" name="payload" value=""><strong>Approve initiative (decision maker)</strong><label>Decision id (must be decided and approved)</label><input type="text" data-p="decisionId" value=""><label>Note</label><input type="text" data-p="note" value=""><button class="io-btn" type="submit">Approve initiative</button></form>{% endif %}
{% if i.stage == 'planning' %}<form class="io-cmd cmd" method="POST" action="/actions/CreatePlan"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Initiative"><input type="hidden" name="recordId" value="{{ i.id }}"><input type="hidden" name="page" value="/initiatives/:id"><input type="hidden" name="redirect" value="/initiatives/{{ i.id }}"><input type="hidden" name="payload" value=""><strong>Create plan</strong><label>Target launch date</label><input type="date" data-p="targetLaunchDate" value=""><label>First milestone</label><input type="text" data-p="milestoneTitle" value=""><label>Milestone date</label><input type="date" data-p="milestoneDate" value=""><button class="io-btn alt" type="submit">Create plan</button></form><form class="io-cmd cmd" method="POST" action="/actions/ApprovePlan"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Initiative"><input type="hidden" name="recordId" value="{{ i.id }}"><input type="hidden" name="page" value="/initiatives/:id"><input type="hidden" name="redirect" value="/initiatives/{{ i.id }}"><input type="hidden" name="payload" value=""><strong>Approve plan (decision maker)</strong><button class="io-btn alt" type="submit">Approve plan</button></form><form class="io-cmd cmd" method="POST" action="/actions/StartBuilding"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Initiative"><input type="hidden" name="recordId" value="{{ i.id }}"><input type="hidden" name="page" value="/initiatives/:id"><input type="hidden" name="redirect" value="/initiatives/{{ i.id }}"><input type="hidden" name="payload" value=""><strong>Start building</strong><button class="io-btn" type="submit">Start building</button></form>{% endif %}
{% if i.stage == 'building' %}<form class="io-cmd cmd" method="POST" action="/actions/RequestLaunchReview"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Initiative"><input type="hidden" name="recordId" value="{{ i.id }}"><input type="hidden" name="page" value="/initiatives/:id"><input type="hidden" name="redirect" value="/initiatives/{{ i.id }}"><input type="hidden" name="payload" value=""><strong>Request launch review (all milestones must be complete)</strong><button class="io-btn" type="submit">Request launch review</button></form>{% endif %}
{% if i.stage == 'launch' %}<form class="io-cmd cmd" method="POST" action="/actions/ApproveLaunch"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Initiative"><input type="hidden" name="recordId" value="{{ i.id }}"><input type="hidden" name="page" value="/initiatives/:id"><input type="hidden" name="redirect" value="/initiatives/{{ i.id }}"><input type="hidden" name="payload" value=""><strong>Approve launch (decision maker; all checks ready or waived)</strong><label>Launch decision id</label><input type="text" data-p="decisionId" value=""><label>Operational owner id</label><input type="text" data-p="operationalOwnerId" value=""><label>Operational owner name</label><input type="text" data-p="operationalOwnerName" value=""><label>Runbook URL</label><input type="text" data-p="runbookUrl" value=""><label>Note</label><input type="text" data-p="note" value=""><button class="io-btn" type="submit">Approve launch</button></form><form class="io-cmd cmd" method="POST" action="/actions/TransitionToOperations"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Initiative"><input type="hidden" name="recordId" value="{{ i.id }}"><input type="hidden" name="page" value="/initiatives/:id"><input type="hidden" name="redirect" value="/initiatives/{{ i.id }}"><input type="hidden" name="payload" value=""><strong>Transition to operations</strong><button class="io-btn" type="submit">Transition to operations</button></form>{% endif %}
{% if i.stage != 'idea' %}<form class="io-cmd cmd" method="POST" action="/actions/RequestDecision"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Initiative"><input type="hidden" name="recordId" value="{{ i.id }}"><input type="hidden" name="page" value="/initiatives/:id"><input type="hidden" name="redirect" value="/initiatives/{{ i.id }}"><input type="hidden" name="payload" value=""><strong>Request a decision</strong><label>Kind</label><select data-p="kind"><option value="approve_initiative">approve_initiative</option><option value="select_approach">select_approach</option><option value="approve_launch">approve_launch</option><option value="scope_change">scope_change</option><option value="retire">retire</option></select><label>Question</label><input type="text" data-p="question" value=""><label>Context</label><textarea data-p="context"></textarea><button class="io-btn alt" type="submit">Request decision</button></form>{% endif %}
</section>
{% else %}<p>Initiative not found.</p>{% endif %}
</div>
