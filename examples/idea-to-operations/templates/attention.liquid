<style>
.io{--ink:#14213d;--muted:#5f6b7a;--line:#dde3ea;--blue:#1d3557;--orange:#e76f51;max-width:1280px;margin:auto;padding:4px 28px 48px;color:var(--ink);font:14px/1.5 Inter,system-ui,sans-serif}.io *{box-sizing:border-box}.io a{color:inherit}.io h1{font-size:34px;letter-spacing:-.04em;margin:8px 0 4px}.io h2{font-size:15px;margin:0 0 12px}.io h3{font-size:12px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin:16px 0 8px}.io-sub{color:var(--muted);margin:0 0 22px}.io-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:16px}.io-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:16px;align-items:start}.io-row{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #eef1f5}.io-row:last-child{border:0}.io-t{font-weight:700;text-decoration:none}.io-m{color:var(--muted);font-size:12px;margin-top:2px}.io-pill{display:inline-block;border-radius:99px;background:#eef2f7;padding:2px 9px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}.io-pill.blocked,.io-pill.at_risk,.io-pill.high,.io-pill.off_target,.io-pill.degraded{background:#ffe8e0;color:#a2391a}.io-pill.attention,.io-pill.medium,.io-pill.watch,.io-pill.pending{background:#fff3d6;color:#8a5a00}.io-pill.healthy,.io-pill.ready,.io-pill.on_target,.io-pill.decided,.io-pill.completed,.io-pill.done{background:#dff3e6;color:#1d6b3a}.io-empty{color:var(--muted);padding:8px 0}.io-stages{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}.io-stage{background:#f6f8fb;border-radius:12px;padding:12px}.io-stage h3{margin-top:0}.io-init{background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px;margin-bottom:8px}.io-cmd{border-top:1px dashed var(--line);margin-top:12px;padding-top:12px}.io-cmd label{display:block;font-size:11px;color:var(--muted);margin:6px 0 2px}.io-cmd input,.io-cmd textarea,.io-cmd select{width:100%;padding:7px 9px;border:1px solid var(--line);border-radius:8px;font:inherit}.io-cmd textarea{min-height:56px}.io-btn{margin-top:8px;background:var(--blue);color:#fff;border:0;border-radius:8px;padding:8px 14px;font-weight:700;cursor:pointer}.io-btn.alt{background:#fff;color:var(--blue);border:1px solid var(--blue)}.io-nav{display:flex;gap:14px;flex-wrap:wrap;margin:6px 0 20px;font-weight:700}.io-nav a{text-decoration:none;color:var(--muted)}.io-nav a:hover{color:var(--ink)}.io-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:18px}.io-kpi{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px}.io-kpi b{display:block;font-size:26px}.io-kpi span{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}@media(max-width:700px){.io{padding:4px 14px}}
</style>
<script>
document.addEventListener('submit',function(e){var f=e.target;if(!f.classList||!f.classList.contains('cmd'))return;var p={};f.querySelectorAll('[data-p]').forEach(function(x){p[x.getAttribute('data-p')]=x.value});f.elements.payload.value=JSON.stringify(p)});
</script>
<div class="io"><nav class="io-nav"><a href="/">Portfolio</a><a href="/attention">Attention</a><a href="/decisions">Decisions</a><a href="/milestones">Milestones</a><a href="/launches">Launches</a><a href="/operations">Operations</a><a href="/observations">Observations</a><a href="/ideas/new">+ Submit an idea</a></nav>{% assign nowTs = 'now' | date: '%s' | plus: 0 %}
<h1>What needs attention</h1><p class="io-sub">Derived from current records on every load (Zebric has no server-side projections; see ZEBRIC_GAPS.md).</p>
{% assign attnCount = 0 %}
<div class="io-grid">
<section class="io-card"><h2>Blocked or at-risk initiatives</h2>{% for i in data.initiatives %}{% if i.health == 'blocked' or i.health == 'at_risk' or i.health == 'attention' %}<div class="io-row"><div><a class="io-t" href="/initiatives/{{ i.id }}">{{ i.title }}</a><div class="io-m">{{ i.stage }} · {{ i.healthReason }}</div></div><span class="io-pill {{ i.health }}">{{ i.health }}</span></div>{% endif %}{% endfor %}</section>
<section class="io-card"><h2>Overdue milestones</h2>{% for m in data.milestones %}{% if m.targetDate %}{% assign ts = m.targetDate | date: '%s' | plus: 0 %}{% if ts < nowTs %}<div class="io-row"><div><span class="io-t">{{ m.title }}</span><div class="io-m">{{ m.initiative.title }} · due {{ m.targetDate | formatDate: "short" }}</div></div><span class="io-pill {{ m.status }}">{{ m.status }}</span></div>{% endif %}{% endif %}{% endfor %}
{% for m in data.milestones %}{% if m.status == 'blocked' %}<div class="io-row"><div><span class="io-t">{{ m.title }}</span><div class="io-m">{{ m.initiative.title }} · blocked</div></div><span class="io-pill blocked">blocked</span></div>{% endif %}{% endfor %}</section>
<section class="io-card"><h2>Decisions waiting on a human</h2>{% for d in data.decisions %}<div class="io-row"><div><a class="io-t" href="/initiatives/{{ d.initiativeId }}">{{ d.question }}</a><div class="io-m">{{ d.initiative.title }}{% if d.dueDate %} · due {{ d.dueDate | formatDate: "short" }}{% endif %}</div></div><span class="io-pill pending">requested</span></div>{% else %}<div class="io-empty">None.</div>{% endfor %}</section>
<section class="io-card"><h2>Launch blockers</h2>{% for c in data.readiness %}<div class="io-row"><div><a class="io-t" href="/initiatives/{{ c.initiativeId }}">{{ c.initiative.title }}</a><div class="io-m">{{ c.category }}: {{ c.title }}</div></div><span class="io-pill {{ c.status }}">{{ c.status }}</span></div>{% else %}<div class="io-empty">None.</div>{% endfor %}</section>
<section class="io-card"><h2>High-impact open risks</h2>{% for r in data.risks %}<div class="io-row"><div><a class="io-t" href="/initiatives/{{ r.initiativeId }}">{{ r.title }}</a><div class="io-m">{{ r.initiative.title }} · {{ r.mitigation }}</div></div><span class="io-pill high">high</span></div>{% else %}<div class="io-empty">None.</div>{% endfor %}</section>
<section class="io-card"><h2>Stale operational reviews</h2>{% for c in data.capabilities %}{% if c.nextReviewDue %}{% assign ts = c.nextReviewDue | date: '%s' | plus: 0 %}{% if ts < nowTs %}<div class="io-row"><div><a class="io-t" href="/initiatives/{{ c.initiativeId }}">{{ c.name }}</a><div class="io-m">review was due {{ c.nextReviewDue | formatDate: "short" }} · owner {{ c.ownerName }}</div></div><span class="io-pill attention">overdue</span></div>{% endif %}{% endif %}{% endfor %}</section>
<section class="io-card"><h2>Open observations</h2>{% for o in data.observations %}<div class="io-row"><div><span class="io-t">{{ o.title }}</span><div class="io-m">{{ o.description }}</div></div><span class="io-pill {{ o.severity }}">{{ o.severity }}</span></div>{% else %}<div class="io-empty">None.</div>{% endfor %} <a href="/observations">Review observations →</a></section>
</div>
</div>
