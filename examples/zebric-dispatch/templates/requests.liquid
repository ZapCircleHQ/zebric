<style>
  .rq{--ink:#17211f;--muted:#68736f;--line:#dfe5e2;--paper:#f5f7f4;--green:#244f46;--orange:#d97745;max-width:1280px;margin:auto;padding:0 28px;color:var(--ink);font:14px/1.45 Inter,ui-sans-serif,system-ui,sans-serif}.rq *{box-sizing:border-box}.rq-head{display:flex;justify-content:space-between;align-items:end;margin:10px 0 24px}.rq h1{font-size:36px;letter-spacing:-.045em;margin:0}.rq-sub{color:var(--muted);margin:5px 0 0}.rq-new{background:var(--green);color:#fff;padding:11px 16px;border-radius:8px;text-decoration:none;font-weight:750}.rq-tools{display:flex;gap:10px;background:#fff;border:1px solid var(--line);border-bottom:0;border-radius:12px 12px 0 0;padding:13px}.rq input,.rq select{border:1px solid var(--line);border-radius:7px;background:#fff;padding:9px 11px;color:var(--ink)}.rq input{min-width:280px}.rq-table{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--line)}.rq-table th{text-align:left;font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);padding:11px 13px;border-bottom:1px solid var(--line)}.rq-table td{padding:13px;border-bottom:1px solid #edf0ee;vertical-align:middle}.rq-table tr:hover td{background:#fafbf9}.rq-title{font-weight:750;color:var(--ink);text-decoration:none}.rq-num{display:block;font:600 10px ui-monospace,monospace;color:var(--muted);margin-bottom:3px}.rq-pill{display:inline-block;border-radius:99px;background:var(--paper);padding:4px 8px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em}.rq-priority-urgent{color:#a93226;background:#fae8e5}.rq-priority-high{color:#9a4e19;background:#fff0df}.rq-empty{text-align:center;color:var(--muted);padding:30px!important}@media(max-width:850px){.rq{padding:0 14px}.rq-tools{flex-wrap:wrap}.rq input{min-width:100%;flex:1}.rq-table{display:block;overflow:auto}.rq-hide-sm{display:none}}
</style>
<div class="rq">
  <header class="rq-head"><div><h1>Requests</h1><p class="rq-sub">Search and scan the operational queue.</p></div><a class="rq-new" href="/requests/new">New request</a></header>
  <div class="rq-tools"><input id="rq-search" type="search" placeholder="Search number, title, owner…" aria-label="Search requests"><select id="rq-status" aria-label="Filter by status"><option value="">All open and closed</option><option value="open">Open</option><option value="new">New</option><option value="triaged">Triaged</option><option value="in_progress">In progress</option><option value="waiting">Waiting</option><option value="completed">Completed</option><option value="cancelled">Cancelled</option></select><select id="rq-owner" aria-label="Filter by ownership"><option value="">Everyone</option><option value="mine">Assigned to me</option><option value="created">Created by me</option></select></div>
  <table class="rq-table"><thead><tr><th>Request</th><th>Category</th><th>Priority</th><th>Status</th><th class="rq-hide-sm">Assignee</th><th class="rq-hide-sm">Updated</th></tr></thead><tbody id="rq-body">
    {% for request in data.requests %}<tr data-request-row data-status="{{ request.status }}" data-assignee="{{ request.assigneeId }}" data-requester="{{ request.requesterId }}" data-search="{{ request.requestNumber }} {{ request.title }} {{ request.assigneeName }} {{ request.category.name }}"><td><span class="rq-num">{{ request.requestNumber | default: request.id }}</span><a class="rq-title" href="/requests/{{ request.id }}">{{ request.title }}</a></td><td>{{ request.category.name | default: request.workflowKey }}</td><td><span class="rq-pill rq-priority-{{ request.priority }}">{{ request.priority }}</span></td><td><span class="rq-pill">{{ request.status | replace: "_", " " }}</span></td><td class="rq-hide-sm">{{ request.assigneeName | default: "Unassigned" }}</td><td class="rq-hide-sm">{{ request.updatedAt | formatDate: "short" }}</td></tr>{% else %}<tr><td colspan="6" class="rq-empty">No requests yet. Create the first one.</td></tr>{% endfor %}
    <tr id="rq-no-match" hidden><td colspan="6" class="rq-empty">No requests match these filters.</td></tr>
  </tbody></table>
</div>
<script>
  (()=>{const search=document.querySelector('#rq-search'),status=document.querySelector('#rq-status'),owner=document.querySelector('#rq-owner'),rows=[...document.querySelectorAll('[data-request-row]')],none=document.querySelector('#rq-no-match'),userId={{ user.id | json }};function apply(){const q=search.value.trim().toLowerCase();let shown=0;for(const row of rows){const s=row.dataset.status;const statusOk=!status.value||(status.value==='open'?!['completed','cancelled'].includes(s):s===status.value);const ownerOk=!owner.value||(owner.value==='mine'?row.dataset.assignee===userId:row.dataset.requester===userId);const searchOk=!q||row.dataset.search.toLowerCase().includes(q);row.hidden=!(statusOk&&ownerOk&&searchOk);if(!row.hidden)shown++}none.hidden=shown!==0}search.addEventListener('input',apply);status.addEventListener('change',apply);owner.addEventListener('change',apply)})()
</script>
