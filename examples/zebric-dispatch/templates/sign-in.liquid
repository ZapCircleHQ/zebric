<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · {{ project.name }}</title>{{ renderer.styles | raw }}<style>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f2f5f2;color:#17211f;font:14px/1.5 Inter,system-ui,sans-serif;padding:20px}.si{width:100%;max-width:390px;background:#fff;border:1px solid #dfe5e2;border-radius:14px;padding:34px}.brand{font-size:15px;font-weight:850;color:#244f46}.si h1{font-size:27px;letter-spacing:-.04em;margin:25px 0 5px}.sub{color:#68736f;margin:0 0 23px}.si form{display:grid;gap:15px}.si label{font-size:12px;font-weight:750}.si input{width:100%;border:1px solid #d5ddda;border-radius:8px;padding:11px;margin-top:5px}.si button{border:0;border-radius:8px;background:#244f46;color:#fff;padding:12px;font-weight:800;cursor:pointer}.note{font-size:11px;color:#89928f;margin-top:20px}</style></head><body><main class="si"><div class="brand">Zebric / Dispatch</div><h1>Sign in to operations.</h1><p class="sub">Requests, approvals, and agent work share one governed record.</p><div>{{ renderer.feedback | raw }}</div><form id="sign-in-form" method="POST" action="{{ auth.action }}"><input type="hidden" name="callbackURL" value="{{ auth.callback }}"><input type="hidden" name="_csrf" value="{{ auth.csrfToken }}">{{ renderer.fields.email | raw }}{{ renderer.fields.password | raw }}<button type="submit">Sign in</button></form><p class="note">Demo accounts are provisioned by the seed script.</p></main>{{ renderer.script | raw }}</body></html>
