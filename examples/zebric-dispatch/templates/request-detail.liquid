<style>
  .rd{--ink:#17211f;--muted:#68736f;--line:#dfe5e2;--paper:#f5f7f4;--green:#244f46;--orange:#d97745;--red:#a33b32;max-width:1280px;margin:auto;padding:0 28px;color:var(--ink);font:14px/1.48 Inter,ui-sans-serif,system-ui,sans-serif}.rd *{box-sizing:border-box}.rd a{color:inherit}.rd-back{display:inline-block;color:var(--muted)!important;text-decoration:none;margin-bottom:17px}.rd-head{display:flex;justify-content:space-between;gap:30px;align-items:start;padding-bottom:23px;border-bottom:1px solid var(--line)}.rd-num{font:700 11px ui-monospace,monospace;color:var(--orange);letter-spacing:.08em}.rd h1{font-size:36px;line-height:1.08;letter-spacing:-.045em;margin:7px 0 12px;max-width:800px}.rd-badges{display:flex;gap:7px;flex-wrap:wrap}.rd-badge{border:1px solid var(--line);border-radius:99px;padding:4px 9px;font-size:10px;text-transform:uppercase;letter-spacing:.06em;font-weight:800;background:#fff}.rd-badge.pending{background:#fff1e7;color:#9b4b20;border-color:#f1cfb9}.rd-layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(290px,.65fr);gap:20px;margin-top:20px}.rd-stack{display:grid;gap:18px;align-content:start}.rd-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:20px}.rd-card h2{font-size:15px;margin:0 0 16px}.rd-desc{white-space:pre-line;font-size:15px;line-height:1.65}.rd-facts{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}.rd-fact label{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:800}.rd-fact div{margin-top:4px;font-weight:650}.rd-progress{display:flex;align-items:start;gap:0;overflow:auto;padding-bottom:4px}.rd-step{min-width:100px;position:relative;padding-top:22px;color:#9aa29f;font-size:11px;font-weight:700}.rd-step:before{content:"";position:absolute;top:5px;left:3px;width:10px;height:10px;border:2px solid #cbd2cf;border-radius:50%;background:#fff}.rd-step:after{content:"";position:absolute;top:10px;left:13px;right:0;height:1px;background:#dfe5e2}.rd-step:last-child:after{display:none}.rd-step.done,.rd-step.now{color:var(--ink)}.rd-step.done:before{background:var(--green);border-color:var(--green)}.rd-step.now:before{border-color:var(--orange);box-shadow:0 0 0 4px #f9e8dc}.rd-approval{border-left:3px solid var(--orange);background:#fffaf6}.rd-approval-head{display:flex;justify-content:space-between;gap:12px}.rd-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.rd button,.rd-btn{border:1px solid var(--line);background:#fff;border-radius:7px;padding:9px 12px;font:700 12px inherit;cursor:pointer;text-decoration:none}.rd button.primary{background:var(--green);border-color:var(--green);color:#fff}.rd button.danger{color:var(--red)}.rd-form{display:grid;gap:9px;margin-top:12px}.rd input,.rd textarea{width:100%;border:1px solid var(--line);border-radius:7px;padding:9px 10px;font:inherit}.rd textarea{min-height:86px;resize:vertical}.rd details summary{cursor:pointer;font-weight:750}.rd-feed{display:grid;gap:0}.rd-event{display:grid;grid-template-columns:12px 1fr;gap:11px;padding:0 0 17px}.rd-dot{width:9px;height:9px;margin-top:5px;border-radius:50%;background:#b9c3bf;box-shadow:0 0 0 4px #f2f5f3}.rd-event.agent .rd-dot{background:var(--orange)}.rd-event.workflow .rd-dot{background:var(--green)}.rd-event p{margin:0}.rd-who{font-weight:800}.rd-time{display:block;font-size:10px;color:var(--muted);margin-top:3px}.rd-comment{padding:14px 0;border-bottom:1px solid #edf0ee}.rd-comment:last-child{border-bottom:0}.rd-comment-head{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-bottom:6px}.rd-comment strong{color:var(--ink)}.rd-empty{color:var(--muted);padding:8px 0}.rd-next{position:sticky;top:90px}.rd-next p{color:var(--muted);font-size:12px}.rd-system{font:600 11px ui-monospace,monospace;color:var(--muted);word-break:break-all}@media(max-width:880px){.rd{padding:0 15px}.rd-layout{grid-template-columns:1fr}.rd-next{position:static}.rd h1{font-size:30px}.rd-facts{grid-template-columns:1fr}}
</style>
{% assign request = data.request[0] %}
<div class="rd">
  <a class="rd-back" href="/requests">← All requests</a>
  {% if request %}
  <header class="rd-head"><div><div class="rd-num">{{ request.requestNumber | default: request.id }}</div><h1>{{ request.title }}</h1><div class="rd-badges"><span class="rd-badge">{{ request.status | replace: "_", " " }}</span><span class="rd-badge">{{ request.priority }}</span><span class="rd-badge {% if request.approvalState == 'pending' %}pending{% endif %}">{{ request.approvalState | replace: "_", " " }}</span></div></div></header>
  <div class="rd-layout">
    <main class="rd-stack">
      <section class="rd-card"><h2>Request</h2><div class="rd-desc">{{ request.description }}</div><div class="rd-facts" style="margin-top:20px"><div class="rd-fact"><label>Category</label><div>{{ request.category.name | default: request.workflowKey }}</div></div><div class="rd-fact"><label>Owner</label><div>{{ request.assigneeName | default: "Unassigned" }}</div></div><div class="rd-fact"><label>Requester</label><div>{{ request.requesterName | default: request.requesterId }}</div></div><div class="rd-fact"><label>Created</label><div>{{ request.createdAt | formatDate: "long" }}</div></div></div></section>
      <section class="rd-card"><h2>Workflow progress</h2><div class="rd-progress">
        <div class="rd-step done">Submitted</div><div class="rd-step {% if request.status == 'triaged' %}now{% elsif request.status == 'in_progress' or request.status == 'waiting' or request.status == 'completed' %}done{% endif %}">Triaged</div>
        {% if request.workflowKey == "access" or request.workflowKey == "purchase" %}<div class="rd-step {% if request.approvalState == 'pending' %}now{% elsif request.approvalState == 'approved' %}done{% endif %}">Approved</div>{% endif %}
        <div class="rd-step {% if request.status == 'in_progress' %}now{% elsif request.status == 'completed' %}done{% endif %}">{% if request.workflowKey == "purchase" %}Purchase{% elsif request.workflowKey == "access" %}Provision{% else %}Work{% endif %}</div>
        {% if request.workflowKey == "access" %}<div class="rd-step {% if request.status == 'completed' %}done{% endif %}">Verify</div>{% endif %}<div class="rd-step {% if request.status == 'completed' %}done{% endif %}">Complete</div>
      </div></section>
      {% for approval in data.approvals %}<section class="rd-card rd-approval"><div class="rd-approval-head"><div><h2>Approval · {{ approval.status }}</h2><div>Requested from <strong>{{ approval.requestedFromName | default: approval.requestedFromId }}</strong> by {{ approval.requestedByName | default: approval.requestedByType }}.</div>{% if approval.reason %}<p>{{ approval.reason }}</p>{% endif %}</div><span class="rd-badge {% if approval.status == 'pending' %}pending{% endif %}">{{ approval.status }}</span></div>
        {% if approval.status == "pending" and user.role == "approver" or approval.status == "pending" and user.role == "admin" %}<div class="rd-actions"><form method="POST" action="/actions/ApproveRequest"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Request"><input type="hidden" name="recordId" value="{{ request.id }}"><input type="hidden" name="page" value="/requests/:id"><input type="hidden" name="redirect" value="/requests/{{ request.id }}"><input type="hidden" name="payload" value='{"approvalId":"{{ approval.id }}"}'><button class="primary" type="submit">Approve</button></form><form method="POST" action="/actions/RejectRequest"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Request"><input type="hidden" name="recordId" value="{{ request.id }}"><input type="hidden" name="page" value="/requests/:id"><input type="hidden" name="redirect" value="/requests/{{ request.id }}"><input type="hidden" name="payload" value='{"approvalId":"{{ approval.id }}","reason":"Rejected in Dispatch"}'><button class="danger" type="submit">Reject</button></form></div>{% endif %}
      </section>{% endfor %}
      <section class="rd-card"><h2>Activity</h2><div class="rd-feed">{% for event in data.activity %}<div class="rd-event {{ event.actorType }}"><span class="rd-dot"></span><div><p><span class="rd-who">{{ event.actorName }}</span> · {{ event.summary }}</p><time class="rd-time">{{ event.createdAt | formatDate: "datetime" }} · {{ event.actorType }}</time></div></div>{% else %}<div class="rd-empty">No activity has been recorded.</div>{% endfor %}</div></section>
      <section class="rd-card"><h2>Comments</h2>{% for comment in data.comments %}<article class="rd-comment"><div class="rd-comment-head"><span><strong>{{ comment.authorName | default: comment.authorId }}</strong> · {{ comment.authorType }}</span><time>{{ comment.createdAt | formatDate: "datetime" }}</time></div><div>{{ comment.body | newline_to_br }}</div></article>{% else %}<div class="rd-empty">No comments yet.</div>{% endfor %}<form id="rd-comment-form" class="rd-form"><label for="rd-comment">Add a comment</label><textarea id="rd-comment" required placeholder="Record a decision, finding, or meaningful progress."></textarea><div><button class="primary" type="submit">Add comment</button></div></form></section>
    </main>
    <aside class="rd-stack"><section class="rd-card rd-next"><h2>Next action</h2>
      {% if request.status == "new" %}<p>This request needs triage before work begins.</p><form method="POST" action="/actions/TriageRequest" class="rd-actions rd-action"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Request"><input type="hidden" name="recordId" value="{{ request.id }}"><input type="hidden" name="page" value="/requests/:id"><input type="hidden" name="redirect" value="/requests/{{ request.id }}"><button class="primary" type="submit">Triage</button></form>{% endif %}
      {% if request.workflowKey == "general" and request.status == "triaged" or request.workflowKey == "general" and request.status == "waiting" %}<p>General operations work can begin.</p><form method="POST" action="/actions/StartGeneralWork" class="rd-actions"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Request"><input type="hidden" name="recordId" value="{{ request.id }}"><input type="hidden" name="page" value="/requests/:id"><input type="hidden" name="redirect" value="/requests/{{ request.id }}"><button class="primary" type="submit">Start work</button></form>{% endif %}
      {% if request.workflowKey != "general" and request.approvalState == "not_required" and request.status != "new" or request.workflowKey != "general" and request.approvalState == "rejected" and request.status != "new" %}<p>This {{ request.workflowKey }} request must be approved before protected work proceeds.</p><details><summary>Request approval</summary><form method="POST" action="/actions/RequestHumanApproval" class="rd-form" data-json-payload><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Request"><input type="hidden" name="recordId" value="{{ request.id }}"><input type="hidden" name="page" value="/requests/:id"><input type="hidden" name="redirect" value="/requests/{{ request.id }}"><input type="hidden" name="payload"><input name="payload_requestedFromId" required placeholder="Approver user ID"><input name="payload_requestedFromName" required placeholder="Approver name"><textarea name="payload_reason" required placeholder="Why approval is required"></textarea><button class="primary" type="submit">Request approval</button></form></details>{% endif %}
      {% if request.approvalState == "pending" %}<p>Human approval is required. Protected work must stop here.</p>{% endif %}
      {% if request.workflowKey != "general" and request.approvalState == "approved" and request.status == "waiting" or request.workflowKey != "general" and request.approvalState == "approved" and request.status == "triaged" %}<p>Approval is recorded. Work may continue.</p><form method="POST" action="/actions/StartProtectedWork" class="rd-actions"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Request"><input type="hidden" name="recordId" value="{{ request.id }}"><input type="hidden" name="page" value="/requests/:id"><input type="hidden" name="redirect" value="/requests/{{ request.id }}"><button class="primary" type="submit">Start approved work</button></form>{% endif %}
      {% if request.status == "in_progress" %}<p>Record progress in comments, then complete or pause the work.</p><div class="rd-actions">{% if request.workflowKey == "general" %}{% assign completion = "CompleteGeneralRequest" %}{% else %}{% assign completion = "CompleteProtectedRequest" %}{% endif %}<form method="POST" action="/actions/{{ completion }}"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Request"><input type="hidden" name="recordId" value="{{ request.id }}"><input type="hidden" name="page" value="/requests/:id"><input type="hidden" name="redirect" value="/requests/{{ request.id }}"><button class="primary" type="submit">Complete</button></form><form method="POST" action="/actions/MarkRequestWaiting"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Request"><input type="hidden" name="recordId" value="{{ request.id }}"><input type="hidden" name="page" value="/requests/:id"><input type="hidden" name="redirect" value="/requests/{{ request.id }}"><button type="submit">Mark waiting</button></form></div>{% endif %}
      {% if request.status == "completed" %}<p>This request is complete. Its history remains available to humans and agents.</p>{% endif %}{% if request.status == "cancelled" %}<p>This request was cancelled.</p>{% endif %}
      {% if request.status != "completed" and request.status != "cancelled" %}<details style="margin-top:16px"><summary>Assign owner</summary><form method="POST" action="/actions/AssignRequest" class="rd-form" data-json-payload><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Request"><input type="hidden" name="recordId" value="{{ request.id }}"><input type="hidden" name="page" value="/requests/:id"><input type="hidden" name="redirect" value="/requests/{{ request.id }}"><input type="hidden" name="payload"><input name="payload_assigneeId" required placeholder="User ID"><input name="payload_assigneeName" required placeholder="Display name"><button type="submit">Assign</button></form></details><form method="POST" action="/actions/CancelRequest" class="rd-actions"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Request"><input type="hidden" name="recordId" value="{{ request.id }}"><input type="hidden" name="page" value="/requests/:id"><input type="hidden" name="redirect" value="/requests/{{ request.id }}"><button class="danger" type="submit" onclick="return confirm('Cancel this request?')">Cancel request</button></form>{% endif %}
      <div class="rd-system" style="margin-top:18px">{{ request.id }}</div>
    </section></aside>
  </div>
  {% else %}<section class="rd-card"><h1>Request not found</h1><p>The request may have been removed or is not available to you.</p></section>{% endif %}
</div>
<script>
  document.querySelectorAll('[data-json-payload]').forEach(form=>form.addEventListener('submit',()=>{const payload={};form.querySelectorAll('[name^="payload_"]').forEach(input=>payload[input.name.slice(8)]=input.value);form.querySelector('[name="payload"]').value=JSON.stringify(payload)}));
  document.querySelector('#rd-comment-form')?.addEventListener('submit',async event=>{event.preventDefault();const button=event.currentTarget.querySelector('button');button.disabled=true;const response=await fetch('/api/comments',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json','x-csrf-token':{{ csrfToken | json }}},body:JSON.stringify({requestId:{{ request.id | json }},authorId:{{ user.id | json }},authorName:{{ user.name | json }},authorType:'user',body:document.querySelector('#rd-comment').value})});if(response.ok)location.reload();else{button.disabled=false;alert('Could not add comment.')}});
</script>
