<style>
  .dispatch{--ink:#17211f;--muted:#68736f;--line:#dfe5e2;--paper:#f5f7f4;--card:#fff;--green:#244f46;--orange:#d97745;max-width:1240px;margin:auto;padding:0 28px;color:var(--ink);font:14px/1.45 Inter,ui-sans-serif,system-ui,sans-serif}.dispatch *{box-sizing:border-box}.d-head{display:flex;align-items:end;justify-content:space-between;margin:10px 0 28px}.d-eyebrow{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--orange)}.dispatch h1{font-size:36px;line-height:1.05;letter-spacing:-.045em;margin:7px 0}.d-sub{color:var(--muted);margin:0}.d-new{background:var(--green);color:#fff;text-decoration:none;padding:11px 16px;border-radius:8px;font-weight:750}.d-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:18px}.d-column{display:grid;gap:18px;align-content:start}.d-panel{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden}.d-panel>header{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid var(--line)}.d-panel h2{font-size:15px;margin:0}.d-count{font:700 11px ui-monospace,monospace;color:var(--muted);background:var(--paper);border-radius:99px;padding:3px 8px}.d-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;padding:15px 18px;border-bottom:1px solid #edf0ee;text-decoration:none;color:inherit}.d-row:last-child{border-bottom:0}.d-row:hover{background:#fafbf9}.d-title{font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.d-meta{display:flex;gap:9px;margin-top:5px;color:var(--muted);font-size:11px}.d-status{font-size:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;color:var(--green)}.d-empty{padding:28px 18px;color:var(--muted);text-align:center}.d-approval{border-left:3px solid var(--orange)}@media(max-width:800px){.dispatch{padding:0 16px}.d-grid{grid-template-columns:1fr}.d-head{align-items:start;gap:16px}.dispatch h1{font-size:30px}}
</style>
<div class="dispatch">
  <header class="d-head"><div><div class="d-eyebrow">Your work queue</div><h1>Good morning, {{ user.name }}.</h1><p class="d-sub">Decisions and work that need your attention now.</p></div><a class="d-new" href="/requests/new">New request</a></header>
  <div class="d-grid">
    <div class="d-column">
      <section class="d-panel d-approval"><header><h2>Needs your approval</h2><span class="d-count">{{ data.needsApproval.size }}</span></header>
        {% for approval in data.needsApproval %}<a class="d-row" href="/requests/{{ approval.requestId }}"><div><div class="d-title">{{ approval.request.title | default: "Protected request" }}</div><div class="d-meta"><span>Requested by {{ approval.requestedByName | default: approval.requestedByType }}</span><span>{{ approval.reason }}</span></div></div><span class="d-status">Decision needed</span></a>{% else %}<div class="d-empty">No approvals are waiting on you.</div>{% endfor %}
      </section>
      <section class="d-panel"><header><h2>Assigned to you</h2><span class="d-count">{{ data.assigned.size }}</span></header>
        {% for request in data.assigned %}<a class="d-row" href="/requests/{{ request.id }}"><div><div class="d-title">{{ request.requestNumber | default: request.id }} · {{ request.title }}</div><div class="d-meta"><span>{{ request.category.name | default: request.workflowKey }}</span><span>{{ request.priority }}</span></div></div><span class="d-status">{{ request.status | replace: "_", " " }}</span></a>{% else %}<div class="d-empty">Nothing is assigned to you.</div>{% endfor %}
      </section>
    </div>
    <div class="d-column">
      <section class="d-panel"><header><h2>Waiting</h2><span class="d-count">{{ data.waiting.size }}</span></header>
        {% for request in data.waiting %}<a class="d-row" href="/requests/{{ request.id }}"><div><div class="d-title">{{ request.requestNumber | default: request.id }} · {{ request.title }}</div><div class="d-meta"><span>{{ request.assigneeName | default: "Unassigned" }}</span><span>{{ request.approvalState | replace: "_", " " }}</span></div></div><span class="d-status">Waiting</span></a>{% else %}<div class="d-empty">No requests are waiting.</div>{% endfor %}
      </section>
      <section class="d-panel"><header><h2>Recently updated</h2><a href="/requests" class="d-status">View all</a></header>
        {% for request in data.recent %}<a class="d-row" href="/requests/{{ request.id }}"><div><div class="d-title">{{ request.title }}</div><div class="d-meta"><span>{{ request.requestNumber | default: request.id }}</span><span>{{ request.updatedAt | formatDate: "short" }}</span></div></div><span class="d-status">{{ request.status | replace: "_", " " }}</span></a>{% else %}<div class="d-empty">No requests yet.</div>{% endfor %}
      </section>
    </div>
  </div>
</div>
