{
  "name": "zebric-dispatch",
  "version": "0.1.0",
  "private": true,
  "description": "Dispatch example app built with Zebric",
  "scripts": {
    "predev": "pnpm --dir ../.. --filter @zebric/runtime-core build",
    "dev": "zebric-engine --blueprint=blueprint.toml --port=3000",
    "seed": "bash seed.sh",
    "validate": "zebric validate --blueprint blueprint.toml",
    "test:workflows": "bash test-workflows.sh"
  },
  "dependencies": {
    "@zebric/cli": "workspace:*",
    "@zebric/runtime-node": "workspace:*"
  }
}
