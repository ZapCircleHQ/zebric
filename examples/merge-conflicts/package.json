{
  "name": "merge-conflicts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auditable, policy-driven merge-conflict workflow example for Zebric",
  "scripts": {
    "dev": "zebric-engine --blueprint=blueprint.toml --port=3012",
    "build": "tsc --noEmit",
    "test": "vitest run tests && node --test security.test.mjs",
    "test:watch": "vitest",
    "pretest": "pnpm --dir ../.. --filter @zebric/cli... build",
    "predev": "pnpm --dir ../.. --filter @zebric/cli... build"
  },
  "dependencies": {
    "@zebric/cli": "workspace:*",
    "@zebric/runtime-node": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
