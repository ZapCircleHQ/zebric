<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · {{ project.name }}</title>{{ renderer.styles | raw }}<style>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f3f6f8;color:#122638;font:14px/1.5 Inter,system-ui,sans-serif;padding:20px}.si{width:100%;max-width:410px;background:#fff;border:1px solid #dbe4ea;border-radius:16px;padding:36px;box-shadow:0 16px 50px #173f5f12}.brand{font-size:15px;font-weight:900;color:#173f5f}.si h1{font-size:29px;letter-spacing:-.04em;margin:25px 0 5px}.sub{color:#667987;margin:0 0 24px}.si form{display:grid;gap:15px}.si input{width:100%;border:1px solid #cfdae1;border-radius:8px;padding:11px;margin-top:5px}.si button{border:0;border-radius:8px;background:#173f5f;color:#fff;padding:12px;font-weight:800;cursor:pointer}.note{font-size:11px;color:#82929d;margin-top:20px}</style></head><body><main class="si"><div class="brand">ZEBRIC CRM</div><h1>Sign in to your pipeline.</h1><p class="sub">Accounts, outreach, approvals, and agent work share one governed record.</p><div>{{ renderer.feedback | raw }}</div><form method="POST" action="{{ auth.action }}"><input type="hidden" name="callbackURL" value="{{ auth.callback }}"><input type="hidden" name="_csrf" value="{{ auth.csrfToken }}">{{ renderer.fields.email | raw }}{{ renderer.fields.password | raw }}<button type="submit">Sign in</button></form><p class="note">Demo users are provisioned by <code>seed.sh</code>.</p></main>{{ renderer.script | raw }}</body></html>

