<style>
.pr{--ink:#122638;--muted:#657986;--line:#dce5ea;--blue:#173f5f;--orange:#e07a3f;max-width:1320px;margin:auto;padding:4px 28px 40px;color:var(--ink);font:14px/1.45 Inter,system-ui,sans-serif}.pr *{box-sizing:border-box}.pr h1{font-size:38px;letter-spacing:-.045em;margin:8px 0}.pr-sub{color:var(--muted);margin:0 0 22px}.pr-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:18px}.pr-card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:18px}.pr-map{height:540px;position:relative;overflow:hidden;background:linear-gradient(135deg,#e8f0ec,#dce8ee)}.pr-map:before{content:"";position:absolute;inset:0;background-image:linear-gradient(#fff5 1px,transparent 1px),linear-gradient(90deg,#fff5 1px,transparent 1px);background-size:42px 42px}.pin{position:absolute;transform:translate(-50%,-50%);width:24px;height:24px;border-radius:50% 50% 50% 0;rotate:-45deg;background:var(--orange);border:3px solid #fff;box-shadow:0 2px 8px #173f5f55}.pin.customer{background:var(--blue)}.pr-legend{position:absolute;z-index:2;left:14px;bottom:14px;background:#fff;padding:9px 12px;border-radius:8px;font-size:11px}.pr-row{padding:13px 0;border-bottom:1px solid #edf1f3}.pr-row:last-child{border:0}.pr-title{font-weight:850}.pr-meta{font-size:11px;color:var(--muted);margin-top:3px}.pr-pill{display:inline-block;border-radius:99px;background:#edf3f6;padding:4px 8px;font-size:10px;text-transform:uppercase;font-weight:850;margin-top:7px}.pr-score{float:right;color:var(--orange);font-weight:900}@media(max-width:900px){.pr{padding:4px 14px}.pr-grid{grid-template-columns:1fr}.pr-map{height:360px}}
</style>
<div class="pr"><h1>Prospecting</h1><p class="pr-sub">Google Places discoveries remain candidates until a governed promotion creates authoritative CRM data.</p><div class="pr-grid"><section class="pr-card pr-map" id="map" aria-label="Candidate map"><div class="pr-legend"><b>Map preview</b><br><span style="color:var(--orange)">●</span> candidates &nbsp; <span style="color:var(--blue)">●</span> customers<br><small>Supply a Maps browser key to replace this contained fallback.</small></div></section><aside class="pr-card"><h2 style="margin-top:0">Candidates</h2>{% for candidate in data.candidates %}<article class="pr-row"><span class="pr-score">{{ candidate.score }}</span><div class="pr-title">{{ candidate.name }}</div><div class="pr-meta">{{ candidate.category }} · {{ candidate.address }}<br>{{ candidate.rating }} ★ · {{ candidate.reviewCount }} reviews</div><span class="pr-pill">{{ candidate.disposition | replace: "_", " " }}</span>{% if candidate.potentialDuplicateAccountId %}<span class="pr-pill" style="color:#a5481e">possible duplicate</span>{% endif %}</article>{% else %}<p class="pr-meta">No candidates yet. Create a ProspectSearch through MCP or the entity API, then run the Google Places adapter described in README.md.</p>{% endfor %}</aside></div><section class="pr-card" style="margin-top:18px"><h2 style="margin-top:0">Recent searches</h2>{% for search in data.searches %}<article class="pr-row"><span class="pr-title">{{ search.query }}</span> near {{ search.location }}<span class="pr-score">{{ search.resultCount }} results</span><div class="pr-meta">{{ search.status }} · {{ search.ownerName }} · {{ search.createdAt | formatDate: "datetime" }}</div></article>{% else %}<p class="pr-meta">No prospect searches.</p>{% endfor %}</section></div>
<script>(()=>{const map=document.querySelector('#map'),candidates={{ data.candidates | json }},accounts={{ data.accounts | json }},points=[...candidates.map(x=>({...x,kind:'candidate'})),...accounts.filter(x=>x.latitude&&x.longitude).map(x=>({...x,kind:'customer'}))];if(!points.length)return;const lats=points.map(x=>Number(x.latitude)),lngs=points.map(x=>Number(x.longitude)),minLat=Math.min(...lats),maxLat=Math.max(...lats),minLng=Math.min(...lngs),maxLng=Math.max(...lngs);points.forEach(p=>{const el=document.createElement('button');el.className='pin '+(p.kind==='customer'?'customer':'');el.style.left=(8+84*(Number(p.longitude)-minLng)/(maxLng-minLng||1))+'%';el.style.top=(8+84*(maxLat-Number(p.latitude))/(maxLat-minLat||1))+'%';el.title=p.name;el.setAttribute('aria-label',p.name);map.appendChild(el)})})()</script>
