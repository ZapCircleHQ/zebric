<style>
.crm{--ink:#122638;--muted:#657986;--line:#dce5ea;--blue:#173f5f;--orange:#e07a3f;max-width:1320px;margin:auto;padding:4px 28px 40px;color:var(--ink);font:14px/1.45 Inter,system-ui,sans-serif}.crm *{box-sizing:border-box}.crm h1{font-size:38px;letter-spacing:-.045em;margin:8px 0}.crm-sub{color:var(--muted);margin:0 0 26px}.crm-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}.crm-kpi,.crm-card{background:#fff;border:1px solid var(--line);border-radius:13px}.crm-kpi{padding:17px}.crm-kpi b{display:block;font-size:28px}.crm-kpi span{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.07em}.crm-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:18px}.crm-card{padding:20px}.crm-card h2{font-size:15px;margin:0 0 14px}.crm-item{display:grid;grid-template-columns:1fr auto;gap:12px;padding:13px 0;border-bottom:1px solid #edf1f3}.crm-item:last-child{border:0}.crm-title{font-weight:800;color:inherit;text-decoration:none}.crm-meta{color:var(--muted);font-size:11px;margin-top:4px}.crm-pill{align-self:start;border-radius:99px;background:#edf3f6;padding:4px 8px;font-size:10px;text-transform:uppercase;font-weight:850}.crm-pill.high,.crm-pill.urgent{background:#fff0e8;color:#a5481e}.crm-empty{color:var(--muted);padding:10px 0}@media(max-width:900px){.crm{padding:4px 14px}.crm-kpis{grid-template-columns:repeat(2,1fr)}.crm-grid{grid-template-columns:1fr}}
</style>
{% assign openInsights = data.insights.size %}{% assign openTasks = data.tasks.size %}{% assign openOpps = data.opportunities.size %}{% assign replies = data.replies.size %}
<div class="crm"><header><h1>What needs attention</h1><p class="crm-sub">Persisted insights and assigned work for {{ user.name }}. Every recommendation links back to CRM state.</p></header><section class="crm-kpis"><div class="crm-kpi"><b>{{ openInsights }}</b><span>Open insights</span></div><div class="crm-kpi"><b>{{ openTasks }}</b><span>Open tasks</span></div><div class="crm-kpi"><b>{{ openOpps }}</b><span>Active opportunities</span></div><div class="crm-kpi"><b>{{ replies }}</b><span>Recent replies</span></div></section>
<div class="crm-grid"><main class="crm-card"><h2>Insights</h2>{% for insight in data.insights %}<article class="crm-item"><div><a class="crm-title" href="/accounts/{{ insight.accountId }}">{{ insight.summary }}</a><div class="crm-meta">{{ insight.evidence }} · Suggested: {{ insight.suggestedAction }}</div></div><span class="crm-pill {{ insight.severity }}">{{ insight.severity }}</span></article>{% else %}<div class="crm-empty">Nothing needs attention right now.</div>{% endfor %}</main><aside style="display:grid;gap:18px;align-content:start"><section class="crm-card"><h2>Assigned work</h2>{% for task in data.tasks %}<article class="crm-item"><div><span class="crm-title">{{ task.title }}</span><div class="crm-meta">{{ task.assigneeName }}{% if task.dueAt %} · {{ task.dueAt | formatDate: "datetime" }}{% endif %}</div></div><span class="crm-pill {{ task.priority }}">{{ task.priority }}</span></article>{% else %}<div class="crm-empty">No open tasks.</div>{% endfor %}</section><section class="crm-card"><h2>Closing pipeline</h2>{% for opp in data.opportunities %}<article class="crm-item"><div><a class="crm-title" href="/opportunities/{{ opp.id }}">{{ opp.name }}</a><div class="crm-meta">{{ opp.account.name }} · {{ opp.expectedCloseDate | formatDate: "short" }}</div></div><span class="crm-pill">{{ opp.stage }}</span></article>{% else %}<div class="crm-empty">No open opportunities.</div>{% endfor %}</section></aside></div></div>

