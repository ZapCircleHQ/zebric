<style>
.ad{--ink:#122638;--muted:#657986;--line:#dce5ea;--blue:#173f5f;--orange:#e07a3f;max-width:1250px;margin:auto;padding:4px 28px 40px;color:var(--ink);font:14px/1.48 Inter,system-ui,sans-serif}.ad *{box-sizing:border-box}.ad a{color:inherit}.ad-back{color:var(--muted)!important;text-decoration:none}.ad-head{display:flex;justify-content:space-between;gap:20px;margin:17px 0 22px;padding-bottom:20px;border-bottom:1px solid var(--line)}.ad h1{font-size:38px;letter-spacing:-.045em;margin:0 0 8px}.ad-pill{display:inline-block;border-radius:99px;background:#edf3f6;padding:4px 8px;font-size:10px;text-transform:uppercase;font-weight:850}.ad-grid{display:grid;grid-template-columns:1.4fr .8fr;gap:18px}.ad-stack{display:grid;gap:18px;align-content:start}.ad-card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:20px}.ad-card h2{font-size:15px;margin:0 0 14px}.ad-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.ad-fact label{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:800}.ad-fact div{margin-top:4px;font-weight:700}.ad-row{display:grid;grid-template-columns:1fr auto;gap:10px;padding:12px 0;border-bottom:1px solid #edf1f3}.ad-row:last-child{border:0}.ad-title{font-weight:800;text-decoration:none}.ad-meta{font-size:11px;color:var(--muted);margin-top:3px}.ad-empty{color:var(--muted)}@media(max-width:850px){.ad{padding:4px 14px}.ad-grid{grid-template-columns:1fr}.ad-facts{grid-template-columns:1fr 1fr}}
</style>
{% assign account = data.account[0] %}<div class="ad"><a class="ad-back" href="/accounts">← Accounts</a>{% if account %}<header class="ad-head"><div><h1>{{ account.name }}</h1><span class="ad-pill">{{ account.status }}</span> <span class="ad-pill">{{ account.industry }}</span></div><div><strong>{{ account.ownerName }}</strong><div class="ad-meta">{{ account.team.name }}</div></div></header><div class="ad-grid"><main class="ad-stack"><section class="ad-card"><h2>Account profile</h2><div class="ad-facts"><div class="ad-fact"><label>Website</label><div>{{ account.website | default: "—" }}</div></div><div class="ad-fact"><label>Phone</label><div>{{ account.phone | default: "—" }}</div></div><div class="ad-fact"><label>Location</label><div>{{ account.city }}, {{ account.state }}</div></div><div class="ad-fact"><label>Source</label><div>{{ account.source }}</div></div><div class="ad-fact"><label>Last activity</label><div>{{ account.lastActivityAt | formatDate: "short" | default: "Never" }}</div></div><div class="ad-fact"><label>Next action</label><div>{{ account.nextAction | default: "—" }}</div></div></div></section><section class="ad-card"><h2>Activity timeline</h2>{% for event in data.activities %}<article class="ad-row"><div><span class="ad-title">{{ event.summary }}</span><div class="ad-meta">{{ event.actorName }} · {{ event.actorType }}{% if event.command %} · {{ event.command }}{% endif %}</div></div><time class="ad-meta">{{ event.occurredAt | formatDate: "datetime" }}</time></article>{% else %}<div class="ad-empty">No recorded activity.</div>{% endfor %}</section></main><aside class="ad-stack"><section class="ad-card"><h2>Contacts</h2>{% for contact in data.contacts %}<article class="ad-row"><div><span class="ad-title">{{ contact.firstName }} {{ contact.lastName }}</span><div class="ad-meta">{{ contact.title }} · {{ contact.email }}</div></div></article>{% else %}<div class="ad-empty">No contacts.</div>{% endfor %}</section><section class="ad-card"><h2>Opportunities</h2>{% for opp in data.opportunities %}<article class="ad-row"><div><a class="ad-title" href="/opportunities/{{ opp.id }}">{{ opp.name }}</a><div class="ad-meta">{{ opp.stage }} · {{ opp.expectedCloseDate | formatDate: "short" }}</div></div><strong>${{ opp.amount }}</strong></article>{% else %}<div class="ad-empty">No opportunities.</div>{% endfor %}</section><section class="ad-card"><h2>Tasks</h2>{% for task in data.tasks %}<article class="ad-row"><div><span class="ad-title">{{ task.title }}</span><div class="ad-meta">{{ task.assigneeName }} · {{ task.status }}</div></div></article>{% else %}<div class="ad-empty">No tasks.</div>{% endfor %}</section></aside></div>{% else %}<section class="ad-card"><h1>Account unavailable</h1><p>It may not exist or your team does not have access.</p></section>{% endif %}</div>

