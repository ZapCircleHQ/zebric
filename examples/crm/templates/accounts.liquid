<style>
.ac{--ink:#122638;--muted:#657986;--line:#dce5ea;--blue:#173f5f;max-width:1320px;margin:auto;padding:4px 28px 40px;color:var(--ink);font:14px/1.45 Inter,system-ui,sans-serif}.ac *{box-sizing:border-box}.ac-head{display:flex;justify-content:space-between;align-items:end;margin:8px 0 24px}.ac h1{font-size:38px;letter-spacing:-.045em;margin:0}.ac-sub{color:var(--muted);margin:4px 0}.ac-new{background:var(--blue);color:#fff;border-radius:8px;padding:11px 15px;text-decoration:none;font-weight:800}.ac-tools{display:flex;gap:9px;padding:13px;background:#fff;border:1px solid var(--line);border-bottom:0;border-radius:12px 12px 0 0}.ac input,.ac select{border:1px solid var(--line);border-radius:7px;padding:9px 11px;background:#fff}.ac input{min-width:280px}.ac table{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--line)}.ac th{text-align:left;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.08em;padding:11px 13px;border-bottom:1px solid var(--line)}.ac td{padding:13px;border-bottom:1px solid #edf1f3}.ac tr:hover td{background:#f9fbfc}.ac-name{font-weight:800;color:inherit;text-decoration:none}.ac-pill{border-radius:99px;background:#edf3f6;padding:4px 8px;font-size:10px;text-transform:uppercase;font-weight:850}.ac-empty{text-align:center;color:var(--muted);padding:30px!important}@media(max-width:850px){.ac{padding:4px 14px}.ac-tools{flex-wrap:wrap}.ac input{min-width:100%}.ac table{display:block;overflow:auto}}
</style>
<div class="ac"><header class="ac-head"><div><h1>Accounts</h1><p class="ac-sub">Operational customer data, scoped to your ownership and support team.</p></div><a class="ac-new" href="/accounts/new">New account</a></header><div class="ac-tools"><input id="ac-search" type="search" placeholder="Search name, industry, city, owner…"><select id="ac-status"><option value="">All statuses</option><option>prospect</option><option>customer</option><option>inactive</option></select><select id="ac-view"><option value="">Team accounts</option><option value="mine">My accounts</option><option value="stale">Stale accounts</option></select></div><table><thead><tr><th><input id="ac-all" type="checkbox" aria-label="Select all"></th><th>Account</th><th>Status</th><th>Industry</th><th>Location</th><th>Owner</th><th>Last activity</th><th>Next action</th></tr></thead><tbody>{% for account in data.accounts %}<tr data-row data-status="{{ account.status }}" data-owner="{{ account.ownerId }}" data-search="{{ account.name }} {{ account.industry }} {{ account.city }} {{ account.ownerName }}" data-stale="{% if account.lastActivityAt %}no{% else %}yes{% endif %}"><td><input type="checkbox" data-select value="{{ account.id }}"></td><td><a class="ac-name" href="/accounts/{{ account.id }}">{{ account.name }}</a><div style="font-size:11px;color:var(--muted)">{{ account.website }}</div></td><td><span class="ac-pill">{{ account.status }}</span></td><td>{{ account.industry }}</td><td>{{ account.city }}{% if account.state %}, {{ account.state }}{% endif %}</td><td>{{ account.ownerName }}</td><td>{{ account.lastActivityAt | formatDate: "short" | default: "Never" }}</td><td>{{ account.nextAction | default: "—" }}</td></tr>{% else %}<tr><td colspan="8" class="ac-empty">No visible accounts.</td></tr>{% endfor %}<tr id="ac-none" hidden><td colspan="8" class="ac-empty">No accounts match.</td></tr></tbody></table><p style="color:var(--muted);font-size:11px">Multi-selection is available for review/export. Zebric does not yet expose safe bulk workflow invocation or saved views; see ZEBRIC_GAPS.md.</p></div>
<script>(()=>{const rows=[...document.querySelectorAll('[data-row]')],q=document.querySelector('#ac-search'),status=document.querySelector('#ac-status'),view=document.querySelector('#ac-view'),none=document.querySelector('#ac-none'),uid={{ user.id | json }};function apply(){let shown=0;for(const row of rows){const okQ=!q.value||row.dataset.search.toLowerCase().includes(q.value.toLowerCase());const okS=!status.value||row.dataset.status===status.value;const okV=!view.value||(view.value==='mine'?row.dataset.owner===uid:row.dataset.stale==='yes');row.hidden=!(okQ&&okS&&okV);if(!row.hidden)shown++}none.hidden=shown!==0}q.addEventListener('input',apply);status.addEventListener('change',apply);view.addEventListener('change',apply);document.querySelector('#ac-all')?.addEventListener('change',e=>document.querySelectorAll('[data-select]').forEach(x=>x.checked=e.target.checked))})()</script>

