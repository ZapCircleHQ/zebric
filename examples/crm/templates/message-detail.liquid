<style>.md{--ink:#122638;--muted:#657986;--line:#dce5ea;--blue:#173f5f;max-width:900px;margin:auto;padding:4px 28px 40px;color:var(--ink);font:14px/1.55 Inter,system-ui,sans-serif}.md *{box-sizing:border-box}.md-back{color:var(--muted);text-decoration:none}.md-card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:24px;margin-top:18px}.md h1{font-size:30px;letter-spacing:-.04em;margin:7px 0}.md-meta{color:var(--muted);font-size:12px}.md-pill{display:inline-block;border-radius:99px;background:#edf3f6;padding:4px 8px;font-size:10px;text-transform:uppercase;font-weight:850}.md-body{white-space:pre-wrap;border-top:1px solid var(--line);padding-top:20px;margin-top:20px}.md textarea{width:100%;min-height:190px;border:1px solid var(--line);border-radius:8px;padding:12px;font:inherit}.md button{border:0;border-radius:8px;background:var(--blue);color:#fff;padding:11px 15px;font-weight:800;cursor:pointer}.md .actions{display:flex;gap:10px;margin-top:12px}</style>
{% assign message = data.message[0] %}<div class="md"><a class="md-back" href="/messages">← Messages</a>{% if message %}<article class="md-card"><span class="md-pill">{{ message.direction }}</span> <span class="md-pill">{{ message.status }}</span>{% if message.classification != "unclassified" %} <span class="md-pill">{{ message.classification | replace: "_", " " }}</span>{% endif %}<h1>{{ message.subject }}</h1><div class="md-meta">From {{ message.sender }} · To {{ message.recipients }} · Owner {{ message.ownerName }}</div><div class="md-body">{{ message.body }}</div>{% if message.status == "pending_review" %}<h2>Human review</h2><p class="md-meta">Assigned to {{ message.reviewerName }}. Sending is blocked until this workflow succeeds.</p><form method="POST" action="/actions/ApproveOutreach"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Message"><input type="hidden" name="recordId" value="{{ message.id }}"><input type="hidden" name="page" value="/messages/:id"><input type="hidden" name="redirect" value="/messages/{{ message.id }}"><textarea name="reviewedBody">{{ message.body }}</textarea><input type="hidden" name="payload" value=""><div class="actions"><button type="submit">Approve outreach</button></div></form>{% elsif message.status == "approved" %}<form method="POST" action="/actions/SendApprovedEmail"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="entity" value="Message"><input type="hidden" name="recordId" value="{{ message.id }}"><input type="hidden" name="page" value="/messages/:id"><input type="hidden" name="redirect" value="/messages/{{ message.id }}"><input type="hidden" name="payload" value="{}"><button type="submit">Send approved email</button></form>{% endif %}</article>{% else %}<article class="md-card"><h1>Message unavailable</h1><p>It may not exist or belong to your team.</p></article>{% endif %}</div>
<script>document.querySelector('form[action="/actions/ApproveOutreach"]')?.addEventListener('submit',event=>{const form=event.currentTarget;form.querySelector('[name="payload"]').value=JSON.stringify({body:form.querySelector('[name="reviewedBody"]').value})})</script>
