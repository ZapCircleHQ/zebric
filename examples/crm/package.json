{
  "name": "zebric-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-native B2B CRM built with Zebric",
  "scripts": {
    "predev": "pnpm --dir ../.. --filter @zebric/cli... build",
    "dev": "zebric-engine --blueprint=blueprint.toml --port=3000",
    "seed": "bash seed.sh",
    "validate": "zebric validate --blueprint blueprint.toml",
    "pretest": "pnpm --dir ../.. --filter @zebric/cli... build",
    "test": "node --test security.test.mjs"
  },
  "dependencies": {
    "@zebric/cli": "workspace:*",
    "@zebric/runtime-node": "workspace:*"
  }
}
