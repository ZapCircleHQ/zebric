{
  "name": "zebric",
  "version": "0.2.3",
  "description": "Zebric - Runtime Engine for ZBL Blueprint JSON (ZBL Runtime Engine)",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "quick-test": "pnpm --filter @zebric/runtime-core test && pnpm --filter @zebric/runtime-hono test && pnpm --filter @zebric/notifications test && pnpm --filter @zebric/runtime-node test && pnpm --filter @zebric/runtime-worker test && pnpm --filter @zebric/framework-stories test && pnpm --filter @zebric/cli test && pnpm --filter @zebric/plugin-sdk test",
    "lint": "eslint \"packages/*/src/**/*.{ts,js,mjs}\" \"packages/docs/*.mjs\" \"packages/docs/src/**/*.ts\" \"plugins/*/src/**/*.{ts,js,mjs}\" \"examples/**/*.{ts,mjs}\" \"scripts/**/*.{ts,js,mjs}\" \"starters/**/*.{ts,js,mjs}\" --no-error-on-unmatched-pattern",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "changeset:check": "node scripts/check-changeset-pr.mjs",
    "version": "changeset version",
    "release:check": "node scripts/check-release-versions.mjs",
    "release": "pnpm release:check && pnpm build && changeset publish",
    "build:templates": "node scripts/build-layout-templates.mjs",
    "prepare": "husky || true",
    "test:parity": "pnpm --filter @zebric/runtime-node test:conformance && pnpm --filter @zebric/runtime-worker test:conformance",
    "test:workers-apps": "pnpm --filter @zebric/runtime-worker... build && node scripts/verify-workers-apps.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.0.11",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.23.0"
}
